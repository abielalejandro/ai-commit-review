---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	read_diff(read_diff)
	classify(classify)
	decide(decide)
	security(security)
	bugs(bugs)
	architecture(architecture)
	__end__([<p>__end__</p>]):::last
	__start__ --> read_diff;
	architecture --> decide;
	bugs --> decide;
	classify --> architecture;
	classify --> bugs;
	classify --> security;
	read_diff --> classify;
	security --> decide;
	decide --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc


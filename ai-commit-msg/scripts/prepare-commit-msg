#!/bin/bash
# prepare-commit-msg: pre-rellena el mensaje con IA (LangGraph, sin OpenClaw).
# Git pasa: $1=archivo del mensaje, $2=source, $3=sha. Nunca aborta el commit.

# Si ya hay source (-m, merge, squash, amend...), no tocar nada.
[ -n "${2:-}" ] && exit 0

# Si el comando no está instalado o no hay API key, no molestar.
command -v ai-commit-msg >/dev/null 2>&1 || exit 0
[ -z "${OPENAI_API_KEY:-}" ] && exit 0

MESSAGE=$(ai-commit-msg 2>/dev/null | head -c 4000 || true)
[ -z "$MESSAGE" ] && { echo "⚠️  Sin sugerencia de IA; se deja el mensaje por defecto." >&2; exit 0; }

# Pre-rellenar conservando los comentarios de git debajo.
printf '%s\n\n%s\n' "$MESSAGE" "$(cat "$1")" > "$1"
